# Spotify "now playing" widget.
# Local: copy this file to `.env` and fill it in (.env is gitignored).
# Production: set the same vars in Vercel → Project → Settings → Environment Variables.
# These are read ONLY by the serverless function api/now-playing.js — never exposed to the browser.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# One-time: generate with `node scripts/get-spotify-token.mjs`
SPOTIFY_REFRESH_TOKEN=
